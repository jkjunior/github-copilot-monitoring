# Auto detect text files and normalize line endings to LF
* text=auto

# JSON files
*.json text eol=lf

# YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Markdown files
*.md text eol=lf

# Docker files
Dockerfile* text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# Shell scripts
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
